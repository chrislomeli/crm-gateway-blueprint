{
  "name": "@platform/infrastructure",
  "version": "0.0.1",
  "description": "Infrastructure utilities and configuration management",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "dev": "esbuild src/index.ts --bundle --platform=node --format=cjs --outdir=dist --watch --external:@crm/* --sourcemap",
    "clean": "rm -rf dist node_modules",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@platform/configuration": "workspace:*",
    "@platform/core": "workspace:*",
    "@platform/services": "workspace:*",
    "async-retry": "^1.3.3",
    "bottleneck": "^2.19.5",
    "dd-trace": "^5.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.11.0",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "opossum": "^7.1.0",
    "uuid": "^11.1.0",
    "vitest": "^3.2.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/opossum": "^8.1.9",
    "@vitest/ui": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0"
  }
}
