{
  "name": "@platform/connectors",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist node_modules",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.config.ts src/test/integration.test.ts",
    "test:watch": "vitest watch",
    "bootstrap:localstack": "../../scripts/setup-localstack-secrets.sh",
    "bootstrap:localstack-logs": "kubectl logs job/localstack-secrets-bootstrap -n data-pipeline",
    "dump:secrets": "tsx scripts/dump-localstack-secrets.ts"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.876.0",
    "@elastic/elasticsearch": "^8.11.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@platform/configuration": "workspace:*",
    "@platform/core": "workspace:*",
    "@platform/infrastructure": "workspace:*",
    "@smithy/types": "^4.3.2",
    "aws-opensearch-connector": "^1.2.0",
    "axios": "^1.11.0",
    "ioredis": "^5.6.1",
    "mysql2": "^3.6.5",
    "pg": "^8.16.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/helmet": "^4.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.5",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.3.0"
  }
}